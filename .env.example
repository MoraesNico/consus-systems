# Chave secreta do Django. Troque por um valor aleatório e longo fora do uso local.
DJANGO_SECRET_KEY=troque-esta-chave-antes-de-publicar
# Modo de depuração (true/false). Mantenha false ao publicar.
DJANGO_DEBUG=false
# Hosts aceitos pelo servidor, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens confiáveis para CSRF (com esquema), separadas por vírgula.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# URL do banco. Sem ela, o Consus usa SQLite local (db.sqlite3).
DATABASE_URL=postgres://consus:consus@db:5432/consus
# Tempo máximo (s) para conectar ao PostgreSQL; usado também por /saude/.
DATABASE_CONNECT_TIMEOUT=2
# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL).
DJANGO_LOG_LEVEL=INFO
# Cookies só por HTTPS (true quando publicado atrás de TLS).
DJANGO_SECURE_COOKIES=false
# Número de workers do Gunicorn.
WEB_CONCURRENCY=3
# Porta publicada no computador (http://localhost:<porta>).
CONSUS_PORTA=8000
# Nome do banco criado pelo serviço db.
POSTGRES_DB=consus
# Usuário do banco.
POSTGRES_USER=consus
# Senha do banco (troque fora do uso local).
POSTGRES_PASSWORD=consus
# Popular dados de demonstração na subida (1 = sim). Idempotente.
CONSUS_POPULAR_DEMO=1
# Intervalo (s) do contador automático de alertas no menu (mínimo 5).
ALERTAS_INTERVALO_SEGUNDOS=30
